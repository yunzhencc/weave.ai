# 以下配置仅供服务端使用，密钥和令牌不要添加 VITE_ 前缀。
# 原有生成、查询和文件接口的访问令牌；配置管理入口不要求此令牌，不是供应商 API 密钥。
AI_API_TOKEN=

# 阿里云百炼，文本和图片共用密钥 https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# 首次初始化的文本兼容接口基址；之后在 /settings/models 修改，图片复用地域域名。
# 默认使用北京地域；密钥与接口地址需属于同一地域。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenRouter https://openrouter.ai
OPENROUTER_API_KEY=

# Fal https://fal.ai
FAL_KEY=

# 模型配置、加密凭据和生成任务共用的 SQLite 目录，部署时需保留；需要 Node.js 24+。
AI_DATA_DIR=.data/ai

# 页面保存 API Key 时必需：Base64 编码的 32 字节随机主密钥，和数据库分别备份。
# 丢失或直接更换会使已有加密凭据无法解密；留空仍可使用允许的环境变量引用。
MODEL_ENCRYPTION_KEY=
# 本地 HTTP / 私网模型服务的精确 host:port 允许列表，逗号分隔；默认只允许公网 HTTPS。
# 例如 localhost:11434；仅由可信部署配置，不由页面更改。
MODEL_ALLOWED_HOSTS=

# 文件存储：fs（本地，默认）或 s3（S3 兼容服务）；密钥仅供服务端使用。
STORAGE_DRIVER=fs
# 相对项目启动目录；部署时需挂载持久化磁盘，与任务数据库分别保存。
STORAGE_FS_ROOT=.data/uploads
# 以下仅在 STORAGE_DRIVER=s3 时必填；AWS 可不填 endpoint，其他服务填写对应地域地址。
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# 默认不发送对象 ACL，访问权限由桶策略管理；R2 必须为 false。
STORAGE_S3_SUPPORTS_ACL=false
# 默认虚拟主机地址形式；仅服务端明确要求路径形式时设置 true。
STORAGE_S3_FORCE_PATH_STYLE=false
